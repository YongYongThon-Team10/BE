# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.
# application.yml의 spring.config.import가 .env를 읽으므로 로컬 실행 시 자동으로 반영된다.

# local 또는 prod
SPRING_PROFILES_ACTIVE=local

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=be
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT: Base64 인코딩된 256비트 이상. 생성 예시: openssl rand -base64 32
# 주석 상태로 두면 local 프로필은 개발용 더미 키를 쓴다. 빈 값(JWT_SECRET_KEY=)으로 두면 부팅이 실패하니 주석을 풀 때는 반드시 값을 채운다.
# prod에서는 반드시 설정한다.
# JWT_SECRET_KEY=
# 만료 시간 (ms). 기본값: Access 1시간, Refresh 7일
JWT_ACCESS_TOKEN_EXPIRE_TIME=3600000
JWT_REFRESH_TOKEN_EXPIRE_TIME=604800000

# 콤마로 구분한 허용 Origin 패턴
CORS_ALLOWED_ORIGINS=*

# OpenAI (E4 자연어 검색). 키가 없으면 E4만 502로 응답하고 나머지는 동작한다. prod에서는 반드시 설정한다.
# 빈 값(OPENAI_API_KEY=)으로 두지 말고 주석을 풀 때 값을 채운다.
# OPENAI_API_KEY=
# 모델과 타임아웃(초). 기본값: gpt-4o-mini, 15
# OPENAI_MODEL=gpt-4o-mini
# AI_SEARCH_PARSE_TIMEOUT_SECONDS=15

# 카카오 로컬 (E14 출발지 장소 검색). 카카오 개발자 콘솔의 REST API 키. 없으면 E14만 502로 응답한다. prod에서는 반드시 설정한다.
# KAKAO_REST_API_KEY=
